Algoritmo Clasficacion()
//Declaraciones
  Definir promedio, p_asistencia como real

//Cuerpo
  Escribir "Ingrese promedio del estudiante (0-10)"
  Leer promedio
  Escribir "Ingrese el porcentaje de asistencia (0 a 100)"
  Leer p_asistencia

  Si promedio >= 9 y p_asistencia >= 90 entonces
    Escribir "Estudiante con rendimiento Excelente"
  SiNo
    Si promedio >= 7 y p_asistencia >= 80 entonces
      Escribir "Estudiante con rendimiento Bueno"
    SiNo
      Si promedio >= 6 y p_asistencia >= 70 entonces
        Escribir "Estudiante con rendimiento Regular"
      SiNo 
        Escribir "Estudiante con rendimiento Deficiente"
      FinSi
    FinSi
  FinSi
FinAlgoritmo
