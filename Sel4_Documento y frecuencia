Algoritmo documento y frecuencia()
//Declaraciones
  Definir monto, porcentaje, descuento, total Como Real
  Definir frecuente Como Caracter

// Cuerpo
  Escribir "Ingrese el monto de la compra:"
  Leer monto
  Escribir "¿Es cliente frecuente? (S/N):"
  Leer frecuente

  Si monto >= 500 Entonces
    porcentaje <- 15
  SiNo
    Si monto >= 300 Entonces
      porcentaje <- 10
    SiNo
      Si monto >= 100 Entonces
        porcentaje <- 5
      SiNo
        porcentaje <- 0
      FinSi
    FinSi
  FinSi

  Si Mayusculas(frecuente) = "S" Entonces
    porcentaje <- porcentaje + 5
  FinSi

  descuento <- monto * porcentaje / 100
  total <- monto - descuento

  Escribir "Descuento aplicado: ", porcentaje, "%"
  Escribir "Total a pagar: $", total
FinAlgoritmo
