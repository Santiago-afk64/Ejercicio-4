Algoritmo ValorFuturo_Anualidad()
//Declaraciones
    Definir D, i, totalDepositado, VF Como Real
    Definir n Como Entero
    Escribir "Depósito mensual:"
    Leer D
    Escribir "Tasa mensual (decimal):"
    Leer i
    Escribir "Número de meses:"
    Leer n

//Cuerpo
    totalDepositado <- D * n
    VF <- D * (((1 + i) ^ n - 1) / i)

    Escribir "Total depositado: ", totalDepositado
    Escribir "Valor futuro: ", VF
FinAlgoritmo
